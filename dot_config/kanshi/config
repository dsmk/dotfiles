# Office: portrait monitor on the left, laptop on the right.
profile office {
    output "Samsung Electric Company C27F398 HTQK904519" enable scale 1 mode 1920x1080 position 0,0
    output "Lenovo Group Limited L2251x Wide 6V8M5043" enable scale 1 mode 1680x1050 transform 90 position 1920,0
    #output eDP-1 enable scale 1 position 1440,0
    output eDP-1 disable

    #exec ~/.config/sway/place-workspaces.sh \
    #exec ~/.local/bin/place-workspaces.sh \
    #    "1:dev" "Samsung Electric Company C27F398 HTQK904519" \
    #    "10: second" "Lenovo Group Limited L2251x Wide 6V8M5043" 

    #exec swaymsg workspace "10: second", move workspace to output "Lenovo Group Limited L2251x Wide 6V8M5043"
}

# Home: another portrait monitor, rotated in the other direction.
# Note that the position is post scaling - use wdisplays to play with configuration and get the correct values
profile home {
    output "Samsung Electric Company LF32TU87 HCPNA00267" enable scale 1.3 position 0,0 mode 3840x2160 
    output "Dell Inc. DELL S2722QC 54F5MD3" enable scale 1.5 transform 90 position 2952,0 mode 3840x2160
    output eDP-1 disable

    #exec swaymsg workspace 2, move workspace to output "Dell Inc. DELL S2722QC 54F5MD3"
}

# Undocked fallback. Keep this after the more specific profiles.
profile laptop {
    output eDP-1 enable scale 1.6 position 0,0
}
