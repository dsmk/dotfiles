#!/usr/bin/env python3
from pathlib import Path
import re

apps_dir = Path.home() / ".local/share/applications"
icons_dir = Path.home() / ".local/share/icons"

def size_rank(path):
    # Prefer the largest hicolor size, e.g. 512x512 over 256x256.
    match = re.match(r"(\d+)x(\d+)$", path.parent.parent.name)
    return int(match.group(1)) if match else 0

for desktop in sorted(apps_dir.glob("com.vivaldi.Vivaldi.flextop.*.desktop")):
    lines = desktop.read_text().splitlines()
    icon_line = next((line for line in lines if line.startswith("Icon=")), None)

    if icon_line is None:
        print(f"Skipped (no Icon= entry): {desktop.name}")
        continue

    # Use the icon's basename so this works whether Icon= currently contains
    # a theme name or a stale absolute path.
    icon_name = Path(icon_line.partition("=")[2]).name
    if icon_name.endswith(".png"):
        icon_name = icon_name[:-4]

    candidates = list(icons_dir.glob(f"hicolor/*/apps/{icon_name}.png"))
    if not candidates:
        print(f"Icon PNG not found for {desktop.name}: {icon_name}")
        continue

    icon_path = max(candidates, key=size_rank).resolve()
    updated = [
        f"Icon={icon_path}" if line.startswith("Icon=") else line
        for line in lines
    ]

    backup = desktop.with_suffix(desktop.suffix + ".bak")
    if not backup.exists():
        backup.write_text("\n".join(lines) + "\n")

    desktop.write_text("\n".join(updated) + "\n")
    print(f"Updated {desktop.name} -> {icon_path}")
