#!/usr/bin/env bash
set -uo pipefail

root="$HOME/projects"
[[ -d "$root" ]] || { echo "Not found: $root"; exit 1; }

# List immediate project directories. NUL delimiters handle spaces in names.
if ! IFS= read -r -d '' project < <(
    find "$root" -mindepth 1 -maxdepth 1 -type d -print0 |
        sort -z |
        fzf --read0 --print0 --prompt='Project> ' --layout=reverse --border
); then
    exit 0 # fzf was cancelled
fi

toolbox run --container dev -- code --new-window "$project"
