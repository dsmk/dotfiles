#!/usr/bin/env bash
set -euo pipefail

root="$HOME/projects"
[[ -d "$root" ]] || exit 1

mapfile -d '' projects < <(
    find "$root" -mindepth 1 -maxdepth 1 -type d -print0 | sort -z
)

((${#projects[@]})) || exit 0

selected=$(
    printf '%s\n' "${projects[@]##*/}" |
        zenity --list \
            --title="Open a project in VS Code" \
            --column="Project" \
            --height=500
) || exit 0

[[ -n "$selected" ]] || exit 0
toolbox run --container dev -- code --new-window "$root/$selected"
